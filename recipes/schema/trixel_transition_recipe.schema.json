{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrixelTransitionRecipe",
  "type": "object",
  "required": ["edge", "terrain_a", "terrain_b", "passes"],
  "properties": {
    "edge": { "type": "string", "description": "Canonical transition edge identifier" },
    "label": { "type": "string", "description": "Human-readable label" },
    "terrain_a": { "type": "string", "description": "Source terrain type" },
    "terrain_b": { "type": "string", "description": "Target terrain type" },
    "canvas": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "default": 16 },
        "height": { "type": "integer", "default": 16 }
      }
    },
    "passes": {
      "type": "array",
      "description": "Ordered execution steps for terminal_trixel.py",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["gradient_fill", "noise_scatter", "h_band", "v_crack", "ember_scatter", "entity_marker"]
          },
          "seed": { "type": ["integer", "null"], "description": "Deterministic RNG seed (null = runtime random)" },
          "top": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
          "bottom": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
          "density": { "type": "number", "minimum": 0, "maximum": 1 },
          "colors": { "type": "array", "items": { "type": "array", "items": { "type": "integer" } } },
          "y": { "type": ["number", "integer"] },
          "x": { "type": ["number", "integer"] },
          "thickness": { "type": ["number", "integer"] },
          "count": { "type": "integer" },
          "color": { "type": "array", "items": { "type": "integer" } },
          "jitter": { "type": "number" },
          "waviness": { "type": "number" },
          "gap_chance": { "type": "number" },
          "branch_chance": { "type": "number" },
          "glow": { "type": "boolean" },
          "glow_color": { "type": "array", "items": { "type": "integer" } },
          "y_start": { "type": ["number", "integer"] },
          "y_end": { "type": ["number", "integer"] }
        }
      }
    }
  }
}
